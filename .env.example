# =============================================================================
# The Analyst Copilot — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to source control.
# Every value below is optional except DATABASE_URL and your provider keys —
# the defaults shown are the ones the code uses.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — PostgreSQL + pgvector (dense vector store)
# -----------------------------------------------------------------------------
# The database must have the pgvector extension available.
# On Azure: Portal -> your PG server -> Server parameters -> azure.extensions -> add 'vector'
# Format: postgresql://user:password@host.postgres.database.azure.com/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host.postgres.database.azure.com/postgres?sslmode=require

# -----------------------------------------------------------------------------
# REQUIRED — LLM providers (per-pass routing)
# Draft (extraction) -> Gemini Flash (fast, free tier)
# Verify (accuracy gate) -> Azure OpenAI GPT-4o (stronger model catches -1 answers)
# Using two different providers means the audit is not the same model marking
# its own homework.
# -----------------------------------------------------------------------------
DRAFT_PROVIDER=gemini
VERIFY_PROVIDER=azure_openai

# Azure OpenAI — Portal -> your OpenAI resource -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# VERIFY_MODEL = the Azure *deployment name*, not the model name
VERIFY_MODEL=gpt-4o

# Gemini — Google AI Studio -> API Keys (aistudio.google.com)
GEMINI_API_KEY=<your-gemini-api-key>
DRAFT_MODEL=gemini-1.5-flash
# Free-tier throttling: raise to match your actual quota to avoid pre-emptive waits
GEMINI_RPM_LIMIT=8
GEMINI_MAX_RETRIES=5

# Default provider when the per-pass values above are unset
LLM_PROVIDER=azure_openai

# Optional fallback if the primary provider fails (outage, rate limit, no key).
# Set to "ollama" for a fully local/offline fallback.
# Requires: ollama serve && ollama pull llama3.1
LLM_FALLBACK_PROVIDER=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
FALLBACK_MODEL=llama3.1

# -----------------------------------------------------------------------------
# REQUIRED — Embeddings
# -----------------------------------------------------------------------------
# "azure_openai" (recommended) or "local" (CPU sentence-transformers, no API key)
EMBEDDING_PROVIDER=azure_openai
# Azure deployment name for the embedding model
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# IMPORTANT: must match the deployment above AND the halfvec(N) column in the DB.
#   text-embedding-3-large -> 3072      text-embedding-3-small -> 1536
# Changing this after ingesting requires recreating the chunks table.
EMBEDDING_DIM=3072
# Local fallback model (used only when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding rate-limit pacing (Azure only).
# Set AZURE_EMBED_TPM_LIMIT to your deployment's REAL quota:
#   Azure AI Foundry -> Deployments -> your embedding deployment
#   -> "Rate limit (Tokens per minute)"
# Batches are sized by estimated token budget, then paced against this number.
AZURE_EMBED_TPM_LIMIT=140000
AZURE_EMBED_TPM_UTILIZATION=0.7
AZURE_EMBED_BATCH_TOKEN_BUDGET=40000
AZURE_EMBED_CHARS_PER_TOKEN=3.5

# -----------------------------------------------------------------------------
# Corpus selection
# -----------------------------------------------------------------------------
# These two MUST describe the same corpus — the dense (table) and sparse (BM25)
# indexes are fused at query time, so mismatched values silently produce
# nonsense. Override both together to A/B a different chunking strategy in
# isolation from the production index.
CHUNKS_TABLE=chunks_section_chunked
BM25_DIR_NAME=bm25_section_chunked

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=50
# Section-aware table grouping: same-section rows accumulate up to this budget
TABLE_CHUNK_SIZE_WORDS=800
# How many pages a statement heading keeps classifying tables that follow it.
# Without this bound, one "Statements of Cash Flows" heading would tag every
# later note table in the document.
STATEMENT_HEADING_PAGE_SPAN=1

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=10
CONTEXT_TOP_K=8
RRF_K=60
# Boost when dense and BM25 independently agree on a chunk
DUAL_AGREEMENT_MULTIPLIER=1.5
# Extra BM25 weight on calculation-shaped questions (exact terms beat semantics)
BM25_CALC_BIAS=2.0

# -----------------------------------------------------------------------------
# Precision gate — the abstention threshold
# -----------------------------------------------------------------------------
ABSTAIN_THRESHOLD=0.55

# -----------------------------------------------------------------------------
# Page recovery
# -----------------------------------------------------------------------------
MIN_PAGE_BREAK_MARKERS=5
WORDS_PER_PAGE_FALLBACK=550
# Page-match tolerance used when scoring evaluation runs
PAGE_LOCATION_TOLERANCE=12

# -----------------------------------------------------------------------------
# Frontend (put these in frontend/.env, not here)
# -----------------------------------------------------------------------------
# VITE_API_TARGET=http://127.0.0.1:8000
# VITE_DEV_PORT=5173
