# =============================================================================
# The Analyst Copilot — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to source control.
# =============================================================================

# Per-pass provider routing
# Draft (extraction) → Gemini Flash (free, fast)
# Verify (accuracy gate) → Azure OpenAI GPT-4o (stronger model, prevents -1 scores)
DRAFT_PROVIDER=gemini
VERIFY_PROVIDER=azure_openai

# Azure OpenAI (Verify pass)
# Endpoint: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
# Key: Azure Portal → your OpenAI resource → Keys and Endpoint → KEY 1
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# API version: check Azure AI Studio → Deployments → your deployment for supported versions
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# VERIFY_MODEL = Azure deployment name (the name you gave it in Azure AI Studio)
VERIFY_MODEL=gpt-4o

# Gemini (Draft pass)
# Key: Google AI Studio → API Keys (aistudio.google.com)
GEMINI_API_KEY=<your-gemini-api-key>
# DRAFT_MODEL = Gemini model name (e.g. gemini-2.0-flash, gemini-1.5-flash)
DRAFT_MODEL=gemini-1.5-flash

# LLM_PROVIDER is the default when DRAFT_PROVIDER/VERIFY_PROVIDER are not set.
# With per-pass routing configured above, this acts as a fallback only.
LLM_PROVIDER=azure_openai

# Fallback provider (optional). If primary fails, retries here.
# Set to "ollama" for a fully local/offline fallback.
# Requires: ollama serve && ollama pull llama3.1
LLM_FALLBACK_PROVIDER=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
FALLBACK_MODEL=llama3.1

# Embedding provider: "azure_openai" (recommended) or "local" (CPU, no API key)
EMBEDDING_PROVIDER=azure_openai
# Azure deployment name for the embedding model (must match name in Azure AI Studio)
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Local fallback model (used only when EMBEDDING_PROVIDER=local)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + pgvector (dense vector store)
# Azure PostgreSQL Flexible Server — get from Azure Portal → your PG server → Connection strings
# Format: postgresql://adminuser:password@servername.postgres.database.azure.com/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host.postgres.database.azure.com/postgres?sslmode=require

# ChromaDB (legacy — only needed to run migration script)
CHROMA_HOST=
CHROMA_PORT=8000

# Tunable thresholds (leave at defaults unless you've run eval/tune_thresholds.py)
ABSTAIN_THRESHOLD=0.75
RETRIEVAL_TOP_K=10
CONTEXT_TOP_K=8
RRF_K=60
DUAL_AGREEMENT_MULTIPLIER=1.5
CHUNK_SIZE_WORDS=400
CHUNK_OVERLAP_WORDS=50
